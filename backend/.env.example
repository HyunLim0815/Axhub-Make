# 应用
APP_NAME=axhub-make-backend
APP_VERSION=2.0.0
DEBUG=true

# 数据库 (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=axhub
DB_PASSWORD=axhub_secret
DB_NAME=axhub_make

# Redis
REDIS_URL=redis://localhost:6379/0

# AI — OpenAI 兼容 API
AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_SIMPLE_MODEL=gpt-4o-mini
AI_COMPLEX_MODEL=o3-mini

# 监控
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# 安全
API_KEY=axhub-dev-key
CORS_ORIGINS=["*"]
